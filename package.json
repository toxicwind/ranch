      "chart.js": "^4.5.1",
      "diff": "^9.0.0",
      "fastembed": "2.1.0",
      "katex": "^0.18.11",
      "kitty-vt-wasm": "^0.2.0",
      "lint-staged": "^17.6.0",
      "lucide-react": "^1.52.0",
