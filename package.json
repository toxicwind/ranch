{
  "description": "Ranch monorepo \u2014 herd (Go), flock (Rust), squawk (Python), lasso (Python), rig (Rust/OpenFang), corral (TS), drover (TS), roost (TS), and shared Bun/TS packages. Estate owns the mise build cache.",
  "name": "ranch",
  "private": true,
  "scripts": {
    "build": "mise exec -- moon run :build",
    "build:drover": "bun run --cwd drover build",
    "ci": "mise exec -- moon ci",
    "lint": "mise exec -- moon run :lint",
    "test": "mise exec -- moon run :test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "version": "1.0.0",
  "workspaces": {
    "packages": [
      "barn/browserless",
      "campfire",
      "corral",
      "drover",
      "drover/sidecar",
      "flock/client",
      "flock/dashboard",
      "stream-broker",
      "switchboard",
      "windmill",
      "task-launch",
      "metaaivm-profile",
      "mesh/catalog",
      "mesh/keypool",
      "mesh/proxy/cuttinggate",
      "mesh/router/herd",
      "tau",
      "tau/packages/*",
      "tau-extensions"
    ],
    "catalog": {
      "@babel/generator": "^7.29.8",
      "@babel/parser": "^7.29.9",
      "@babel/traverse": "^7.29.8",
      "@babel/types": "^7.29.8",
      "@huggingface/transformers": "^4.3.0",
      "@napi-rs/cli": "3.7.2",
      "@tau/tau-stats": "workspace:*",
