# Browserless MCP client configuration — points at the live mesh server.
BROWSERLESS_HOST=127.0.0.1
BROWSERLESS_PORT=25130
BROWSERLESS_PROTOCOL=http
BROWSERLESS_TIMEOUT=30000
BROWSERLESS_CONCURRENT=5
# The server-side token lives ONLY in 0600 /home/toxic/.browserless/.env
# (see server/.env.example). NEVER commit a token value here.
# BROWSERLESS_TOKEN=
