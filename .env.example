# OpenFang Environment Variables
# Copy this file to .env and fill in your values.
# Only set the providers you plan to use.

# ─── LLM Provider API Keys ───────────────────────────────────────────

# Anthropic (Claude models)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GEMINI_API_KEY=AIza...
# GOOGLE_API_KEY=AIza...          # Alternative to GEMINI_API_KEY

# OpenAI
# OPENAI_API_KEY=sk-...

# Groq (fast inference)
# GROQ_API_KEY=gsk_...

# DeepSeek
# DEEPSEEK_API_KEY=sk-...

# OpenRouter (multi-provider gateway)
# OPENROUTER_API_KEY=sk-or-...

# Together AI
# TOGETHER_API_KEY=...

# Mistral AI
# MISTRAL_API_KEY=...

# Fireworks AI
# FIREWORKS_API_KEY=...

# Novita AI (multi-model gateway)
# NOVITA_API_KEY=...

# ─── Local LLM Providers (no API key needed) ─────────────────────────

# Ollama (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# vLLM (default: http://localhost:8000)
# VLLM_BASE_URL=http://localhost:8000

# LM Studio (default: http://localhost:1234)
# LMSTUDIO_BASE_URL=http://localhost:1234

# ─── Channel Tokens ──────────────────────────────────────────────────

# Telegram
# TELEGRAM_BOT_TOKEN=123456:ABC-...

# Discord
# DISCORD_BOT_TOKEN=...

# Slack
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# WhatsApp (via Cloud API)
# WHATSAPP_TOKEN=...
# WHATSAPP_PHONE_ID=...

# Signal
# SIGNAL_CLI_PATH=/usr/local/bin/signal-cli
# SIGNAL_PHONE_NUMBER=+1...

# Matrix
# MATRIX_HOMESERVER=https://matrix.org
# MATRIX_ACCESS_TOKEN=...

# Email (IMAP/SMTP)
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_USERNAME=...
# EMAIL_PASSWORD=...

# ─── OpenFang Configuration ──────────────────────────────────────────

# API server bind address (default: 127.0.0.1:3000)
# OPENFANG_LISTEN=127.0.0.1:3000

# API key for HTTP authentication (leave empty for localhost-only access)
# OPENFANG_API_KEY=

# Home directory (default: ~/.openfang)
# OPENFANG_HOME=~/.openfang

# Log level (default: info)
# RUST_LOG=info
# RUST_LOG=openfang=debug        # Debug OpenFang only

# ─── More LLM Providers ──────────────────────────────────────────────

# Kimi / Moonshot
# KIMI_API_KEY=<redacted>

# Azure OpenAI
# AZURE_OPENAI_API_KEY=<redacted>

# ElevenLabs (voice)
# ELEVENLABS_API_KEY=<redacted>

# Google Vertex AI
# VERTEX_AI_ACCESS_TOKEN=<redacted>
# VERTEX_AI_REGION=us-central1

# AWS Bedrock
# AWS_BEARER_TOKEN_BEDROCK=<redacted>
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1

# Google Cloud (for GCP-backed providers)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=...
# GOOGLE_CLOUD_REGION=us-central1
# GCLOUD_PROJECT=...
# GCP_PROJECT=...

# ─── More Channels ───────────────────────────────────────────────────

# Gotify push notifications
# GOTIFY_SERVER_URL=https://gotify.example.com
# GOTIFY_APP_TOKEN=<redacted>

# WhatsApp web gateway (local gateway service; distinct from Cloud API above)
# WHATSAPP_WEB_GATEWAY_URL=http://127.0.0.1:8080

# ─── OpenFang Configuration (continued) ──────────────────────────────

# Agents directory override (default: <home>/agents)
# OPENFANG_AGENTS_DIR=~/.openfang/agents

# Allow unauthenticated access (DANGEROUS — isolated dev only)
# OPENFANG_ALLOW_NO_AUTH=false

# Enable Parakeet MLX transcription backend (Apple Silicon)
# OPENFANG_ENABLE_PARAKEET_MLX=false

# Subprocess timeout in seconds
# OPENFANG_SUBPROCESS_TIMEOUT_SECS=120

# Chrome/Chromium binary path override (browser tooling)
# CHROME_PATH=/usr/bin/chromium

# OpenClaw state dir (migration/compat)
# OPENCLAW_STATE_DIR=~/.openclaw

# Codex home dir override
# CODEX_HOME=~/.codex
