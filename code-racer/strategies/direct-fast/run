#!/usr/bin/env python3
"""direct-fast: single-shot codegen on the fastest local model (beellama :25122).

One call, no iteration. Wins on latency; loses on hard tasks. That's the race.
Ceiling: 90s.
"""
import os, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
from cr import *

CEILING = 90

def main(task_dir, output_path):
    arm_timeout(CEILING)
    spec = read_task(task_dir)
    lang = spec.get("language", "python")
    log(f"direct-fast: {spec.get('id')} -> {FAST_MODEL}@{FAST_URL}")
    text = chat(FAST_URL, FAST_MODEL, spec_prompt(spec),
                max_tokens=2048, temperature=0.2, timeout=70)
    code = extract_code(text, lang)
    if not code:
        log("empty response"); return 1
    dest = write_solution(output_path, f"solution.{ext(lang)}", code)
    log(f"wrote {dest} ({len(code)} chars)")
    return 0

def ext(lang):
    return {"python": "py", "javascript": "js", "typescript": "ts",
            "rust": "rs", "go": "go"}.get(lang.lower(), "txt")

if __name__ == "__main__":
    sys.exit(main(sys.argv[1], sys.argv[2]))
