#!/bin/bash
# qs-restart — bounce quickshell through the canonical path.
# Systemd-aware: if the quickshell-ii unit is active, restart the unit.
set -u
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
QS_HOME="$(cd "$HERE/.." && pwd)"
. "$QS_HOME/lib/qs-common.sh"

if qs_unit_active; then
  echo "restarting via systemd unit $QS_UNIT"
  systemctl --user restart "$QS_UNIT"
  exit 0
fi
"$HERE/qs-stop"
exec "$HERE/qs-launch" "$@"
