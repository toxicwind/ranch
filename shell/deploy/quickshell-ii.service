[Unit]
Description=quickshell ii shell (estate-scripts/projects/shell)
Documentation=file:///home/toxic/estate/ranch/shell/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# qs-launch --systemd runs quickshell in the foreground (no setsid, no pgrep
# guard — systemd IS the guard). Env (WAYLAND_DISPLAY, HYPRLAND_INSTANCE_SIGNATURE)
# is auto-detected by qs-launch at each (re)start; qs-launch preflights the
# wayland socket and exits 0 when no display is reachable, so a headless boot
# must NOT crash-loop (Restart=on-failure keeps a clean exit quiet).
ExecStart=/home/toxic/estate/ranch/shell/bin/qs-launch --systemd -c ii
Restart=on-failure
RestartSec=2
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=graphical-session.target
