[Unit]
Description=quickshell ii shell (sovereign/projects/shell)
Documentation=file:///home/toxic/estate/ranch/shell/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# qs-launch --systemd runs quickshell in the foreground (no setsid, no pgrep
# guard — systemd IS the guard). Env (WAYLAND_DISPLAY, HYPRLAND_INSTANCE_SIGNATURE)
# is auto-detected by qs-launch at each (re)start.
ExecStart=/home/toxic/estate/ranch/shell/bin/qs-launch --systemd -c ii
Restart=always
RestartSec=2
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=graphical-session.target
