#!/usr/bin/env bun
// yote-conn-fast: Bun-native bridge exec via ws_daemon unix socket directly.
// Skips: python CLI startup (96ms) + connector HTTP daemon hop (~30ms).
// Path: bun -> unix socket -> ws_daemon -> WS -> yote.
import { connect } from "net";
import { randomBytes } from "crypto";

const SOCK = `${process.env.HOME}/.cache/awrawr-ws-bridge.sock`;

const args = process.argv.slice(2);
if (args.length < 1 || args[0] === "-h" || args[0] === "--help") {
  console.log("usage: yote-conn-fast \"<cmd>\" [workdir] [timeout_s]");
  process.exit(2);
}
const cmd = args[0];
const workdir = args[1] || "/home/toxic";
const timeout = args[2] ? parseInt(args[2]) : 120;

const sock = connect(SOCK);
const t0 = Bun.nanoseconds();

let buf = Buffer.alloc(0);
let done = false;

sock.on("connect", () => {
  const payload = JSON.stringify({ cmd, workdir, timeout }) + "\n";
  sock.write(payload);
});

sock.on("data", (d) => {
  buf = Buffer.concat([buf, d]);
  let idx;
  while ((idx = buf.indexOf("\n")) !== -1) {
    const line = buf.subarray(0, idx).toString();
    buf = buf.subarray(idx + 1);
    if (!line.trim()) continue;
    try {
      const doc = JSON.parse(line);
      const t = doc.type;
      if (t === "chunk") {
        if (doc.stream === "stderr") process.stderr.write(doc.data || "");
        else process.stdout.write(doc.data || "");
      } else if (t === "done") {
        done = true;
        const ms = Number(Bun.nanoseconds() - t0) / 1e6;
        if (doc.error) console.error(`error: ${doc.error}`);
        console.error(`[fast] ${ms.toFixed(1)}ms code=${doc.code}`);
        sock.destroy();
        process.exit(doc.code ?? 0);
      } else if (t === "error") {
        done = true;
        console.error(`bridge error: ${doc.message}`);
        sock.destroy();
        process.exit(1);
      }
    } catch { /* skip bad line */ }
  }
});

sock.on("error", (e) => {
  console.error(`socket error: ${e.message}`);
  process.exit(1);
});

setTimeout(() => {
  if (!done) { console.error("timeout waiting for bridge"); process.exit(1); }
}, (timeout + 60) * 1000);
