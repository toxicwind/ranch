#!/usr/bin/env python3
"""cron-honest-status: honest classification of scheduler run records.

Reads cron run records and reports the HONEST classification for each one,
because status="succeeded" is a lie for runs that did zero work (safety veto,
overlap-skip, no-op, coalescing). The real reason is buried in result_summary.

Input (stdin): a JSON object {"runs": [...]}, a JSON array [...], or JSONL
(one JSON object per line). Output: one JSON object per line (always valid
JSON, machine-readable), or human-readable lines by default.

The classifier is imported from cron-trust-monitor (single source of truth)
so the CLI and the monitor can never diverge.

Usage:
    cron.runs -> JSON -> cron-honest-status --classify [--summary] [--json]
    cron.runs -> JSONL -> cron-honest-status --classify
    cron-honest-status --state            # per-job honest table from trust state
    cron-honest-status --ledger           # recent monitor health trend

Honest classes:
    genuine        - positive evidence of work (worker receipt or execution detail)
    vetoed         - safety review blocked it (short boilerplate veto notice)
    overlap-skip   - skipped: another run already active
    no-op          - ran but did nothing by design
    quota-deferred - deferred by quota guard
    coalesced      - scheduler coalesced the overlapping occurrence (precedence)
    failed         - status=failed (with or without error text), or worker-reported failure
    timeout        - worker exceeded execution timeout
    ambiguous      - null/empty summary, or non-empty summary without positive
                     work evidence; also cancelled without coalesce evidence
    excluded       - non-terminal record (running/queued/scheduled): not a verdict,
                     excluded from trust math
"""

import json
import os
import sys
import argparse
from collections import Counter
from importlib.machinery import SourceFileLoader

BIN_DIR = os.path.dirname(os.path.abspath(__file__))
TRUST_MONITOR = os.path.join(BIN_DIR, "cron-trust-monitor")
DEFAULT_STATE = os.path.expanduser("~/workspace/fleet-ping/cron-trust-state.json")
DEFAULT_LEDGER = os.path.expanduser("~/workspace/fleet-ping/cron-trust-ledger.jsonl")


def load_classifier():
    mod = SourceFileLoader("cron_trust_monitor", TRUST_MONITOR).load_module()
    return mod.classify_run


def read_runs(stream):
    """Accept a JSON object {"runs": [...]}, a JSON array, or JSONL."""
    text = stream.read()
    if not text.strip():
        raise ValueError("empty stdin: expected JSON object, JSON array, or JSONL")
    try:
        payload = json.loads(text)
    except json.JSONDecodeError:
        payload = None
    if payload is not None:
        runs = payload.get("runs") if isinstance(payload, dict) else payload
        if isinstance(runs, list):
            return runs
        raise ValueError('expected a JSON array, {"runs": [...]}, or JSONL')
    # Fall back to JSONL: one JSON object per line.
    runs = []
    for i, line in enumerate(text.splitlines(), 1):
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError as e:
            raise ValueError("line %d is not valid JSON: %s" % (i, e))
        if not isinstance(obj, dict):
            raise ValueError("line %d: expected a JSON object, got %s"
                             % (i, type(obj).__name__))
        runs.append(obj)
    if not runs:
        raise ValueError("no valid JSON found on stdin")
    return runs


def cmd_classify(classify_run, args):
    try:
        runs = read_runs(sys.stdin)
    except ValueError as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(2)
    out = []
    for run in runs:
        honest, reason = classify_run(run)
        out.append({
            "run_id": run.get("run_id"),
            "job_id": run.get("job_id"),
            "scheduled_for_utc": run.get("scheduled_for_utc"),
            "honest_status": honest if honest is not None else "excluded",
            "reason": reason,
        })
    if args.summary:
        counts = Counter(o["honest_status"] for o in out)
        print(json.dumps({"total": len(out), "by_status": dict(counts),
                          "runs": out}, indent=2))
    elif args.json:
        print(json.dumps(out, indent=2))
    elif args.machine:
        for o in out:
            print(json.dumps(o))
    else:
        for o in out:
            rid = (o["run_id"] or "?")[:8]
            print("%s %s %s: %s" % (o["job_id"], rid, o["honest_status"], o["reason"]))


def cmd_state(args):
    path = args.state_path or DEFAULT_STATE
    try:
        with open(path) as f:
            st = json.load(f)
    except FileNotFoundError:
        print("no trust state at %s (cron-trust-monitor has not run yet)" % path)
        sys.exit(1)
    except json.JSONDecodeError as e:
        print("trust state corrupt at %s: %s" % (path, e))
        sys.exit(1)
    jobs = st.get("jobs", {})
    print("trust state updated: %s  jobs tracked: %d\n"
          % (st.get("updated", "?"), len(jobs)))
    rows = []
    for job_id in sorted(jobs):
        recent = jobs[job_id].get("recent", [])
        classes = [r.get("honest", "?") for r in recent]
        last_ts = recent[-1].get("ts", "") if recent else ""
        rows.append((job_id, ",".join(classes) or "-", last_ts))
    w = max([len(r[0]) for r in rows] + [6])
    print("%-*s  recent-classes              last-ts" % (w, "job"))
    for job_id, classes, last_ts in rows:
        print("%-*s  %-28s %s" % (w, job_id, classes, last_ts))
    counts = Counter(c for _, classes, _ in rows
                     for c in classes.split(",") if c != "-")
    print("\nclass totals across tracked jobs: %s" % dict(counts))


def cmd_ledger(args):
    path = args.ledger_path or DEFAULT_LEDGER
    try:
        with open(path) as f:
            lines = [ln.strip() for ln in f if ln.strip()]
    except FileNotFoundError:
        print("no ledger at %s" % path)
        sys.exit(1)
    tail = lines[-args.limit:]
    print("last %d cron-trust-monitor ledger entries:\n" % len(tail))
    for ln in tail:
        try:
            e = json.loads(ln)
        except json.JSONDecodeError:
            continue
        print("%s  healthy=%s  jobs=%s  issues=%s  nonterminal-excluded=%s"
              % (e.get("ts", "?"), e.get("healthy"), e.get("jobs_checked"),
                 e.get("issues_found"), e.get("excluded_nonterminal", 0)))


def main():
    parser = argparse.ArgumentParser(description="Honest cron run classification")
    parser.add_argument("--classify", action="store_true",
                        help="Read cron.runs records as JSON/JSONL from stdin and classify each")
    parser.add_argument("--summary", action="store_true",
                        help="With --classify: emit counts-by-classification summary")
    parser.add_argument("--json", action="store_true",
                        help="With --classify: pretty-printed JSON array output")
    parser.add_argument("--machine", action="store_true",
                        help="With --classify: one compact JSON object per line")
    parser.add_argument("--state", action="store_true",
                        help="Print per-job honest table from the trust-monitor state file")
    parser.add_argument("--state-path", default=None, help="Override trust state path")
    parser.add_argument("--ledger", action="store_true",
                        help="Print recent monitor health trend from the ledger")
    parser.add_argument("--ledger-path", default=None, help="Override ledger path")
    parser.add_argument("--limit", type=int, default=10,
                        help="Ledger entries to show (default 10)")
    args = parser.parse_args()

    if args.state:
        cmd_state(args)
        return
    if args.ledger:
        cmd_ledger(args)
        return
    if args.classify:
        cmd_classify(load_classifier(), args)
        return
    parser.print_help()
    print("\nClassifier source: cron-trust-monitor (single source of truth).")
    print("Example: cron.runs -> JSON -> cron-honest-status --classify --summary")
    print("Example: cron.runs -> JSONL -> cron-honest-status --classify --machine")


if __name__ == "__main__":
    main()
