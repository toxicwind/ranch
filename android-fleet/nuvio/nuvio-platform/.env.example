# toxicwind streams — environment configuration
# Copy to .env and fill in your values

# Core
SECRET_KEY=changeme_to_64_char_hex
BASE_URL=https://your-domain.com

# Debrid (at least one required)
TORBOX_KEY=your_torbox_api_key
RD_KEY=your_realdebrid_api_key
AD_KEY=your_alldebrid_api_key

# AI / Translation
OPENROUTER_KEY=sk-or-v1-...
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
GEMINI_KEY=AIzaSy...

# APIs
TMDB_KEY=your_tmdb_key
TRAKT_ID=your_trakt_client_id
TRAKT_SECRET=your_trakt_secret

# Proxy (optional — for bypassing IP blocks)
ADDON_PROXY=

# P2P CDN
P2P_TRACKER_URL=wss://tracker.toxicwind.is
P2P_STUN_SERVER=stun:stun.l.google.com:19302
