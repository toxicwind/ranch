<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<addon id="plugin.video.redlight" name="Lasso" version="2.6.7" provider-name="kodi-fleet">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.pil" version="1.1.7"/>
        <import addon="script.module.requests" version="2.19.1"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="resources/lib/redlight.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="resources/lib/service.py"/>
    <extension point="xbmc.python.module" library="resources/lib/"/>
    <extension point="xbmc.addon.metadata">
        <reuselanguageinvoker>true</reuselanguageinvoker>
        <summary lang="en">Lasso</summary>
        <description lang="en">* AllDebrid, Offcloud, Premiumize, Real Debrid and TorBox
* AIOStreams
* EasyNews, NZB Indexers and Local Folders
* MDBList, PunchPlay, Simkl, TMDb Lists, Trakt and WeTrakr</description>
        <disclaimer lang="en">The author of this add-on does not host any content and has no affiliation with the content providers</disclaimer>
        <language>en</language>
        <platform>all</platform>
        <license>GPL-3.0</license>
        <source>kodi-fleet fork (GPL-3.0)</source>
        <news>Check the Changelog in Tools &gt; Changelog &amp; Log Utils</news>
        <assets>
            <icon>resources/media/addon_icons/icon.png</icon>
            <fanart>resources/media/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
