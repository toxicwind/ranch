{
  "name": "chronos-forge-omnibus",
  "version": "0.1.0",
  "private": true,
  "description": "Repo-scoped Chronos MoE backplane: hash-keyed sessions, per-repo state/manifest, proof-gated mutation clusters, endless cycle.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/chronos/index.js",
  "types": "./dist/chronos/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/chronos/index.d.ts",
      "default": "./dist/chronos/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test --import ./test/register.ts test/",
    "test:watch": "node --test --watch --import ./test/register.ts test/",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "dev": "node --watch --import ./scripts/dev-loader.ts scripts/dev.ts",
    "chronos:bootstrap": "node --import ./scripts/dev-loader.ts scripts/bootstrap.ts",
    "chronos:cycle": "node --import ./scripts/dev-loader.ts scripts/cycle.ts",
    "validate": "bun run typecheck && bun run test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "agent-orchestration",
    "mixture-of-experts",
    "proof-gated",
    "autonomous",
    "chronos"
  ]
}
