# kite monorepo (ranch/hatch) — local mirrors, runs, and ephemera
# The cell /opt mirror carries the 341MB runtime binary; never commit it.
opt-hatch/
runs/
worktrees/

# userscript captures (timestamped drops + archives)
userscripts-*/
userscripts-*.tar.gz
20261016-*/

# env + secrets (direnv pointers belong to the machine, not the repo)
.envrc
.env.local
.env.*
!.env.example

# tokens / session material from decode work
*token*.json
notary*.json
*.jsonl

# build + runtime noise
__pycache__/
.venv/
node_modules/
*.pyc
