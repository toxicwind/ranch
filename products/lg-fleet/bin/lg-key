#!/usr/bin/env bun
// lg-key --auto: refresh the LG dev key whenever SSH fails, end-to-end.
// doctrine: the passphrase is only obtainable when the key server answers
// (dev-mode app foregrounded) — this tool fetches, decrypts (LG_PASS),
// provisions the ares entry, and PROVES with ssh; exit 0 = lane healthy.
import { execSync, spawnSync } from "node:child_process";
import { existsSync, readFileSync, writeFileSync, chmodSync } from "node:fs";

const TV = process.env.LG_TV ?? "10.0.0.176";
const KEYDIR = `${process.env.HOME}/.ssh`;
const ENC = `${KEYDIR}/lg-tv_webos`;
const CLEAR = `${KEYDIR}/lg-tv_webos_clear`;
const PASS = process.env.LG_PASS ?? "";

function sshOk(): boolean {
	try {
		// traditional-format key preferred (ares can't parse PKCS#8); fall back to clear
		const key = existsSync(`${KEYDIR}/lg-tv_webos_trad`) ? `${KEYDIR}/lg-tv_webos_trad` : CLEAR;
		const r = spawnSync("ssh", [
			"-i", key, "-o", "IdentitiesOnly=yes", "-o", "StrictHostKeyChecking=no",
			"-o", "HostKeyAlgorithms=+ssh-rsa", "-o", "PubkeyAcceptedAlgorithms=+ssh-rsa",
			"-o", "ConnectTimeout=6", "-p", "9922", `prisoner@${TV}`, "echo LG_SSH_OK",
		], { timeout: 15000, encoding: "utf8" });
		return (r.stdout ?? "").includes("LG_SSH_OK");
	} catch {
		return false;
	}
}

if (existsSync(CLEAR) && sshOk()) {
	console.log("lg-key: existing clear key healthy — nothing to do");
	process.exit(0);
}

// fetch fresh key (key server only answers while dev-mode app is foregrounded)
const code = spawnSync("curl", ["-sf", "-m", "10", `http://${TV}:9991/webos_rsa`, "-o", ENC], { timeout: 15000 });
if (code.status !== 0) {
	console.error(`FAIL: key server unreachable at ${TV}:9991 — open the Developer Mode app on the TV`);
	process.exit(1);
}
chmodSync(ENC, 0o600);
console.log(`key fetched: ${ENC}`);

if (!PASS) {
	console.error("FAIL: LG_PASS not set — cannot decrypt (6-char case-sensitive passphrase on TV screen)");
	process.exit(1);
}
const dec = spawnSync("openssl", ["rsa", "-in", ENC, "-passin", `pass:${PASS}`, "-out", CLEAR], { timeout: 15000 });
if (dec.status !== 0) {
	console.error("FAIL: passphrase rejected by key");
	process.exit(1);
}
chmodSync(CLEAR, 0o600);
console.log("key decrypted");

// ares/node can't parse PKCS#8 ("BEGIN PRIVATE KEY") — webOS tooling needs
// traditional "BEGIN RSA PRIVATE KEY". Convert in place (idempotent).
const TRAD = `${KEYDIR}/lg-tv_webos_trad`;
const conv = spawnSync("openssl", ["rsa", "-in", CLEAR, "-traditional", "-out", TRAD], { timeout: 15000 });
if (conv.status === 0) chmodSync(TRAD, 0o600);

// provision ares device entry (traditional-format key — ares requirement)
const ARES_KEY = existsSync(TRAD) ? TRAD : CLEAR;
execSync(`python3 - ${TV} ${ARES_KEY} ${process.env.HOME}/.webos/tv/novacom-devices.json <<'PY'
import json, os, sys
tv, key, store = sys.argv[1], sys.argv[2], sys.argv[3]
os.makedirs(os.path.dirname(store), exist_ok=True)
devs = json.load(open(store)) if os.path.exists(store) else []
entry = {
    "name": "lg-tv", "profile": "tv", "type": "starfish",
    "host": tv, "port": 9922, "username": "prisoner",
    "files": "stream", "description": "LG webOS TV dev mode",
    "default": False, "password": "",
    "privateKey": {"openSsh": os.path.basename(key)},
}
devs = [d for d in devs if d.get("name") != "lg-tv"] + [entry]
json.dump(devs, open(store, "w"), indent=4)
print("device entry written:", store)
PY`, { stdio: "inherit" });

if (!sshOk()) {
	console.error("FAIL: ssh proof failed after refresh");
	process.exit(1);
}
console.log(`OK: ${TV} provisioned (ares device 'lg-tv') — lane healthy`);
