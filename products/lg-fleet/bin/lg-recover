#!/usr/bin/env bash
# lg-recover — production recovery for the LS2/privilege layer (rooted TV).
# Fixes what ares-install alone cannot:
#   1. patch com.palm.lunasend.json role: add app's service to allowedNames
#   2. bind /var/lib/webosbrew into the jail (persistent logs)
#   3. restart sam (appinfo.json is cached at boot)
#   4. stop a stale service holding the bus name
# Root path: Homebrew Channel exec service (rooted TV) via ares-novacom.
# Usage: lg-recover [app-id] [service-id]
set -uo pipefail

TV_IP="${TV_IP:-10.0.0.176}"
APPID="${1:-com.toxicwind.slate}"
SVC="${2:-${APPID}.server}"
NOVACOM="${NOVACOM:-/home/toxic/.npm-global/bin/ares-novacom}"

step() { printf "\n== %s ==\n" "$1"; }

# Root exec via hbchannel (runs as root on rooted TVs; needs dev key only)
root() {
  "$NOVACOM" -d lg-tv --run "luna-send -n 1 -f luna://org.webosbrew.hbchannel.service/exec '{\"command\":$(python3 -c 'import json,sys;print(json.dumps(sys.argv[1]))' "$1")}'" 2>&1
}

step "1/4 role file: allow app -> service bus registration"
root "python3 - <<'PY'
import json, pathlib
for p in [pathlib.Path('/usr/share/ls2/roles/prv/com.palm.lunasend.json'),
          pathlib.Path('/var/palm/ls2/roles/prv/com.palm.lunasend.json')]:
    if not p.exists(): continue
    role = json.loads(p.read_text())
    names = role['role']['allowedNames']
    if '${SVC}' not in names:
        names.append('${SVC}')
        p.write_text(json.dumps(role, indent=2))
        print('patched:', p, '->', '${SVC}')
    else:
        print('already:', p)
PY"

step "2/4 jail mount: persist service logs across reboot"
root "grep -q '/var/lib/webosbrew' /media/developer/jail_app.conf 2>/dev/null || echo 'mount rw /var/lib/webosbrew' >> /media/developer/jail_app.conf; grep webosbrew /media/developer/jail_app.conf | head -1"

step "3/4 stale bus: stop previous holder of the service name"
root "luna-send-pub -n 1 luna://com.webos.applicationManager/close '{\"id\":\"${APPID}\"}' ; echo closed"

step "4/4 restart sam (re-reads appinfo.json) — needs reboot to take ls-hubd role changes"
root "restart sam 2>/dev/null || true; echo 'sam restarted (role changes need full reboot: reboot now or at your leisure)'"

echo "\nlg-recover: done — reboot the TV once for ls-hubd to reload role files"
