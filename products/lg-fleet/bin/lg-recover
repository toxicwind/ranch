#!/usr/bin/env bash
# lg-recover — root-channel fixes for LG webOS SLATE service bus privilege.
# Three layers (verified against webos-mcp LS2 role docs):
#   1. role file: add com.toxicwind.slate.server to com.palm.lunasend allowedNames
#   2. jail mount: persist service logs via /var/lib/webosbrew in jail_app.conf
#   3. SAM/bus: restart sam (re-reads appinfo.json) + clean stale bus holder
set -uo pipefail
TV="${TV_IP:-10.0.0.176}"
TV_PORT="${TV_SSH_PORT:-9922}"
KEY="$HOME/.ssh/lg-tv_webos_trad"
APPID="com.toxicwind.slate"
SVC="com.toxicwind.slate.server"
ssh(){ ssh -i "$KEY" -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedAlgorithms=+ssh-rsa -o ConnectTimeout=10 -p "$TV_PORT" prisoner@"$TV" "$1"; }
echo "== 1/4 role file: allow app -> service bus registration =="
for r in /usr/share/ls2/roles/prv/com.palm.lunasend.json /var/palm/ls2/roles/prv/com.palm.lunasend.json; do
  ssh "test -f '$r'" >/dev/null 2>&1 || continue
  ssh "python3 -c \"import json,pathlib;p=pathlib.Path('$r');r=json.loads(p.read_text());n=r['role'].setdefault('allowedNames',[]);print('patched' if ('$SVC' not in n and (n.append('$SVC') or p.write_text(json.dumps(r,indent=2)))) else 'already')\""
done
echo "== 2/4 jail mount: persist service logs across reboot =="
ssh "grep -q '/var/lib/webosbrew' /media/developer/jail_app.conf 2>/dev/null || echo 'mount rw /var/lib/webosbrew' >> /media/developer/jail_app.conf"
ssh "grep webosbrew /media/developer/jail_app.conf 2>/dev/null | head -1"
echo "== 3/4 stale bus: close previous holder of the service name =="
ssh "luna-send-pub -n 1 luna://com.webos.applicationManager/close '{\"id\":\"$APPID\"}' >/dev/null 2>&1; echo closed"
echo "== 4/4 restart sam (re-reads appinfo.json) =="
ssh "restart sam 2>/dev/null || true" >/dev/null 2>&1; echo "sam restarted (role changes need full reboot for ls-hubd)"
echo "lg-recover: done"
