#!/usr/bin/env bash
# lg-diag-v2 — production LG webOS lane health: overlay + bus + SAM + jail + ports.
# Replaces the v1 8-point crypto-path diag. Layer model (external record, 2026-10-29):
#   host toolchain -> role/privilege boundary -> boot-time caches -> runtime ports.
# Run FIRST, before any install. Exit code = number of failures.
set -uo pipefail

TV_IP="${TV_IP:-10.0.0.176}"
SSH_KEY="${SSH_KEY:-$HOME/.ssh/lg-tv_webos_trad}"
APPID="${APPID:-com.toxicwind.slate}"
SVC="${SVC:-com.toxicwind.slate.server}"
OVERLAY="/media/developer/apps/usr/palm"

SSH_OPTS=(-i "$SSH_KEY" -o IdentitiesOnly=yes -o StrictHostKeyChecking=no
  -o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedAlgorithms=+ssh-rsa
  -o ConnectTimeout=5 -p 9922 "prisoner@$TV_IP")

fail=0
check() { printf "%-38s %s\n" "$1" "$2"; [ "$2" = "ok" ] || fail=$((fail+1)); }

tv() { ssh "${SSH_OPTS[@]}" "$1" 2>/dev/null; }

# 1. SSH reachability
tv "true" >/dev/null && check "ssh" "ok" || { check "ssh" "fail"; echo "lg-diag: TV unreachable"; exit 1; }

# 2. host toolchain pin (ares CLI needs Node <=16; TV service needs its own runtime)
check "overlay app"    "$(tv "test -d $OVERLAY/applications/$APPID && echo ok || echo missing")"
check "overlay service" "$(tv "test -d $OVERLAY/services/$SVC && echo ok || echo missing")"

# 3. SAM cache: does listApps see the app? (SAM caches appinfo.json at boot)
check "sam manifest"   "$(tv "luna-send-pub -n 1 luna://com.webos.applicationManager/listApps '{}' 2>/dev/null" | grep -q "\"$APPID\"" && echo ok || echo stale)"

# 4. bus registration (service names are globally unique — a stale holder blocks re-register)
check "bus service"    "$(tv "luna-send-pub -n 1 luna://com.webos.service.bus/listServices '{}' 2>/dev/null" | grep -q "\"$SVC\"" && echo ok || echo missing)"

# 5. jail mount for persistent logs (/tmp is per-jail + cleared on boot)
check "jail mount"     "$(tv "grep -q '/var/lib/webosbrew' /media/developer/jail_app.conf && echo ok || echo missing")"

# 6. service ports
for port in 8080 11470; do
  check "port $port"   "$(tv "ss -ltn 2>/dev/null | grep -q ':$port ' && echo ok || echo down")"
done

echo "---"
[ "$fail" -eq 0 ] && echo "lg-diag: all ok" || echo "lg-diag: $fail failure(s)"
exit "$fail"
