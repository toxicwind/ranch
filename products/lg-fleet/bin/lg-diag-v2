#!/usr/bin/env bash
# lg-diag-v2 — LG webOS SLATE service health check (overlay + bus + SAM + jail + ports).
# Run FIRST, before any install. Overlay path = /media/developer/apps/usr/palm (dev-mode),
# NOT /media/cryptofs (read-only production partition).
set -uo pipefail
TV="${TV_IP:-10.0.0.176}"
TV_PORT="${TV_SSH_PORT:-9922}"
APPID="com.toxicwind.slate"
SVC="com.toxicwind.slate.server"
KEY="$HOME/.ssh/lg-tv_webos_trad"
fail=0
check(){ printf "%-38s %s\n" "$1" "$2"; [ "$2" = "ok" ] || fail=$((fail+1)); }
ssh(){ ssh -i "$KEY" -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedAlgorithms=+ssh-rsa -o ConnectTimeout=8 -p "$TV_PORT" prisoner@"$TV" "$1" 2>/dev/null; }
# 1. SSH reachability
ssh "true" >/dev/null 2>&1 && check "ssh" "ok" || check "ssh" "fail"
# 2. Overlay app dir
ssh "test -d /media/developer/apps/usr/palm/applications/$APPID" >/dev/null 2>&1 && check "overlay app" "ok" || check "overlay app" "missing"
# 3. Overlay service dir
ssh "test -d /media/developer/apps/usr/palm/services/$SVC" >/dev/null 2>&1 && check "overlay service" "ok" || check "overlay service" "missing"
# 4. SAM cache: does listApps see it?
ssh "luna-send-pub -n 1 luna://com.webos.applicationManager/listApps '{}' 2>/dev/null | grep -q '\"$APPID\"'" >/dev/null 2>&1 && check "sam manifest" "ok" || check "sam manifest" "stale"
# 5. Bus registration
ssh "luna-send-pub -n 1 luna://com.webos.service.bus/listServices '{}' 2>/dev/null | grep -q '\"$SVC\"'" >/dev/null 2>&1 && check "bus service" "ok" || check "bus service" "missing"
# 6. Jail mount for persistent logs
ssh "grep -q '/var/lib/webosbrew' /media/developer/jail_app.conf 2>/dev/null" >/dev/null 2>&1 && check "jail mount" "ok" || check "jail mount" "missing"
# 7. Service ports
for port in 8080 11470; do
  ssh "ss -ltn 2>/dev/null | grep -q ':$port '" >/dev/null 2>&1 && check "port $port" "ok" || check "port $port" "down"
done
echo "---"
[ "$fail" -eq 0 ] && echo "lg-diag-v2: all ok" || echo "lg-diag-v2: $fail failure(s)"
exit "$fail"
