#!/usr/bin/env bun
// lg-hot — live-reload dev server for the SLATE web UI.
// Serves the SLATE app/dist over HTTP with SSE live-reload so UX iteration
// is instant: edit app/dist -> browsers/TV reload automatically, no 58MB ipk
// reinstall cycle. Fast-iterate until absolute maximal user-UX aesthetic grade.
// Usage: lg-hot [--app <dir>] [--port <n>] [--host <ip>] [--open] [--tv]
import { serve } from "bun";
import { resolve, join } from "node:path";
import { existsSync, readFileSync, readdirSync, watch } from "node:fs";

const args = process.argv.slice(2);
const flagVal = (name, dflt) => { const i = args.indexOf(name); return i >= 0 && i + 1 < args.length ? args.splice(i, 2)[1] : dflt; };
const has = (name) => args.includes(name);

const PORT = Number(flagVal("--port", "18080"));
const HOST = flagVal("--host", "0.0.0.0");
const APP = resolve(flagVal("--app", "/home/toxic/pens/ranch/products/nuvio/nuvio-webos/app"));
const openBrowser = has("--open");
const SHOW_URL = has("--tv");

const clients = new Set<ReadableStreamDefaultController>();
// Bun-native SSE: a ReadableStream that stays open until the client leaves.
const broadcaster = () => {
	let writer: WritableStreamDefaultWriter | null = null;
	const stream = new ReadableStream({
		start(controller) {
			writer = controller as unknown as WritableStreamDefaultWriter;
			clients.add(controller);
			controller.enqueue(new TextEncoder().encode("data: connected\n\n"));
		},
		cancel() { clients.delete(controller); },
	});
	return new Response(stream, { status: 200, headers: { "content-type": "text/event-stream", "cache-control": "no-cache", connection: "keep-alive" } });
};

const broadcastReload = () => {
	const frame = new TextEncoder().encode("data: reload\n\n");
	for (const c of clients) { try { c.enqueue(frame); } catch { clients.delete(c); } }
};

const indexHtml = existsSync(join(APP, "index.html")) ? readFileSync(join(APP, "index.html"), "utf8") : "<h1>SLATE</h1>";
const serve = (req) => {
	const url = new URL(req.url, `http://${req.headers.host}`);
	if (url.pathname === "/__reload") return broadcaster(req);
	if (url.pathname === "/" || url.pathname === "/index.html") {
		const body = indexHtml.replace("</head>", `<script>
(function(){var es=new EventSource('/__reload');es.onmessage=function(e){if(e.data==='reload')location.reload();};console.log('lg-hot live-reload armed');})();
</script></head>`);
		return new Response(body, { headers: { "content-type": "text/html" } });
	}
	const p = join(APP, url.pathname.slice(1));
	if (existsSync(p) && !p.endsWith("/")) {
		const b = readFileSync(p);
		const ct = p.endsWith(".js") ? "application/javascript" : p.endsWith(".css") ? "text/css" : p.endsWith(".png") ? "image/png" : p.endsWith(".json") ? "application/json" : "text/plain";
		return new Response(b, { headers: { "content-type": ct } });
	}
	return new Response(indexHtml, { headers: { "content-type": "text/html" } });
};

Bun.serve({ port: PORT, hostname: HOST, fetch: serve });
const OPEN_URL = `http://127.0.0.1:${PORT}`;
console.log(`lg-hot: serving ${APP} on http://${HOST === "0.0.0.0" ? "<LAN-IP>" : HOST}:${PORT} (live-reload)`);
if (openBrowser) Bun.spawnSync(["xdg-open", OPEN_URL]);
if (SHOW_URL) console.log(`TV: open http://<this-host-ip>:${PORT}/ on the webOS browser / dev-hosted app`);
// watch app/dist -> broadcast reload
let timer = null, last = 0;
// Bun.watch needs directories — index.html changes surface via the dist dir
// and the served file is read fresh per request (see serve()).
const watchDirs = [join(APP, "dist")].filter(d => existsSync(d));
for (const d of watchDirs) {
	const watcher = watch(d, { recursive: true }, () => {
		const now = Date.now();
		if (now - last < 800) { if (!timer) timer = setTimeout(() => { timer = null; last = Date.now(); broadcastReload(); }, 800); return; }
		last = now; broadcastReload();
	});
}
setInterval(() => {}, 1000);
