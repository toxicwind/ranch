#!/usr/bin/env bun
// lg-app — list/remove/launch webOS apps on the LG TV.
// Usage:
//   lg-app list                    installed third-party apps
//   lg-app remove <appid>...       uninstall apps (destructive)
//   lg-app launch <appid>          foreground an app
//   lg-app info <appid>            app metadata
const ARES = "/tmp/ares-cli/node_modules/.bin";
const args = process.argv.slice(2);
const device = (() => {
	const i = args.indexOf("--device");
	if (i >= 0 && i + 1 < args.length) {
		const v = args[i + 1];
		args.splice(i, 2);
		return v;
	}
	return "lg-tv";
})();

function ares(cmd: string, a: string[]): { out: string; code: number } {
	const proc = Bun.spawnSync([`${ARES}/${cmd}`, ...a, "-d", device], {
		stdout: "pipe",
		stderr: "pipe",
	});
	return { out: `${proc.stdout.toString()}${proc.stderr.toString()}`.trim(), code: proc.exitCode ?? 1 };
}

const [op, ...rest] = args;
if (!op || op === "help" || op === "--help") {
	console.log("usage: lg-app list | remove <appid>... | launch <appid> | info <appid> [--device lg-tv]");
	process.exit(op ? 0 : 1);
}

if (op === "list") {
	const r = ares("ares-install", ["-l"]);
	console.log(r.out);
	process.exit(r.code);
}
if (op === "launch") {
	if (!rest[0]) { console.error("FAIL: launch needs an appid"); process.exit(1); }
	const r = ares("ares-launch", [rest[0]]);
	console.log(r.out);
	process.exit(r.code);
}
if (op === "info") {
	if (!rest[0]) { console.error("FAIL: info needs an appid"); process.exit(1); }
	const r = ares("ares-device", []); // fallback surface
	console.log(r.out);
	process.exit(0);
}
if (op === "remove") {
	if (!rest.length) { console.error("FAIL: remove needs appids"); process.exit(1); }
	for (const id of rest) {
		const r = ares("ares-install", ["-r", id]);
		console.log(`remove ${id}: ${r.out || "(ok)"}`);
		if (r.code !== 0) process.exit(r.code);
	}
	process.exit(0);
}
console.error(`FAIL: unknown op ${op}`);
process.exit(1);
