# standalone/whatsapp-mcp — project-owned daemon manifest. Source of truth for 'whatsapp-mcp'.
# Owned by the standalone/whatsapp-mcp project; the parent only composes it.

[daemons.whatsapp-mcp]
port = 25146
run = "bash -c 'set -a; source /home/toxic/.config/pitchfork-secrets/whatsapp-mcp.env; set +a; exec /home/toxic/archive/home-dirs-2026/.whatsapp-mcp-venv/bin/python /home/toxic/src/local/whatsapp-mcp/server.py'"
dir = "/home/toxic/src/local/whatsapp-mcp"
mise = false
retry = true
ready_http = "http://127.0.0.1:25146/health"
auto = ["start"]
env = { WHATSAPP_MCP_PORT = "25146" }

