# standalone/boundless — project-owned daemon manifest. Source of truth for 'boundless'.
# Owned by the standalone/boundless project; the parent only composes it.

[daemons.boundless]
port = 25197
run = "exec /home/toxic/boundless/.venv/bin/python -m uvicorn web.server:app --host 127.0.0.1 --port ${BOUNDLESS_PORT}"
dir = "/home/toxic/boundless"
mise = false
retry = true
boot_start = true
env = { PORT = "25197", HOST = "127.0.0.1", BOUNDLESS_PORT = "25197" }
auto = ["start"]
# awrawr-ws-exec websocket bridge (2026-09-14): persistent stdlib-asyncio WS
# exec server; handshake/framing borrowed from squawk-ws. Same token, command
# policy and audit as the HTTPS bridge (awrawr_mcp.py). Funnel: /exec-ws -> :25204.
