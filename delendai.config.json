{
  "project": "ranch",
  "development": {
    "profile": "shared-checkout-merge",
    "guard": { "unknownActor": "person" }
  },
  "validationMatrix": {
    "scopes": {
      "cookie-vault": [
        {
          "command": "cd cookie-vault && bun --check src/cli.js",
          "expect": "exit0"
        },
        {
          "command": "cd cookie-vault && bun --check src/keeper-cdp.js",
          "expect": "exit0"
        },
        { "command": "cd cookie-vault && bun test", "expect": "exit0" }
      ],
      "default": [{ "command": "git diff --check", "expect": "exit0" }]
    }
  }
}
